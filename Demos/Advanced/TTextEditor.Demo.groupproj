<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{ED98A30C-619C-434D-B9B5-E1B489BDA89D}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="..\..\Packages\TextEditor.Delphi.Runtime.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="..\..\Packages\TextEditor.Delphi.Designtime.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="TTextEditorDemo.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="TextEditor_Delphi_Runtime">
        <MSBuild Projects="..\..\Packages\TextEditor.Delphi.Runtime.dproj"/>
    </Target>
    <Target Name="TextEditor_Delphi_Runtime:Clean">
        <MSBuild Projects="..\..\Packages\TextEditor.Delphi.Runtime.dproj" Targets="Clean"/>
    </Target>
    <Target Name="TextEditor_Delphi_Runtime:Make">
        <MSBuild Projects="..\..\Packages\TextEditor.Delphi.Runtime.dproj" Targets="Make"/>
    </Target>
    <Target Name="TextEditor_Delphi_Designtime">
        <MSBuild Projects="..\..\Packages\TextEditor.Delphi.Designtime.dproj"/>
    </Target>
    <Target Name="TextEditor_Delphi_Designtime:Clean">
        <MSBuild Projects="..\..\Packages\TextEditor.Delphi.Designtime.dproj" Targets="Clean"/>
    </Target>
    <Target Name="TextEditor_Delphi_Designtime:Make">
        <MSBuild Projects="..\..\Packages\TextEditor.Delphi.Designtime.dproj" Targets="Make"/>
    </Target>
    <Target Name="TTextEditorDemo">
        <MSBuild Projects="TTextEditorDemo.dproj"/>
    </Target>
    <Target Name="TTextEditorDemo:Clean">
        <MSBuild Projects="TTextEditorDemo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="TTextEditorDemo:Make">
        <MSBuild Projects="TTextEditorDemo.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="TextEditor_Delphi_Runtime;TextEditor_Delphi_Designtime;TTextEditorDemo"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="TextEditor_Delphi_Runtime:Clean;TextEditor_Delphi_Designtime:Clean;TTextEditorDemo:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="TextEditor_Delphi_Runtime:Make;TextEditor_Delphi_Designtime:Make;TTextEditorDemo:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
