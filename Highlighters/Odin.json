{
  "Highlighter": {
    "Sample": [
      "// Hello, World! in Odin\r\n",
      "\r\n",
      "package main\r\n",
      "\r\n",
      "import \"core:fmt\"\r\n",
      "\r\n",
      "main :: proc() {\r\n",
      "    fmt.println(\"Hello, World!\")\r\n",
      "}"
    ],
    "MainRules": {
      "Attributes": {
        "Element": "Editor"
      },
      "Properties": {
        "HighlightMethodCalls": true,
        "NestedComments": true
      },
      "CaseSensitive": true,
      "SubRules": {
        "Range": [
          {
            "Type": "BlockComment",
            "Attributes": {
              "Element": "Comment"
            },
            "TokenRange": {
              "Open": "/*",
              "Close": "*/"
            }
          },
          {
            "Type": "LineComment",
            "Attributes": {
              "Element": "Comment"
            },
            "Properties": {
              "CloseOnEndOfLine": true
            },
            "TokenRange": {
              "Open": "//"
            }
          },
          {
            "Type": "String",
            "Attributes": {
              "Element": "String"
            },
            "Properties": {
              "CloseOnEndOfLine": true
            },
            "TokenRange": {
              "Open": "'",
              "Close": "'"
            },
