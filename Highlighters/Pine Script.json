  "Highlighter": {
    "Sample": [
      "//@version=6\r\n",
      "indicator(\"Hello, World!\", overlay = true)\r\n",
      "\r\n",
      "// Moving average cross\r\n",
      "int length = input.int(14, \"Length\", minval = 1)\r\n",
      "color upColor = #26A69A\r\n",
      "\r\n",
      "float fast = ta.sma(close, length)\r\n",
      "float slow = ta.ema(close, length * 2)\r\n",
      "\r\n",
      "if ta.crossover(fast, slow) and not na(slow[1])\r\n",
      "    label.new(bar_index, high, 'Cross\\nup', color = upColor, size = size.small)\r\n",
      "\r\n",
      "plot(fast, \"Fast\", fast > slow ? upColor : color.red)\r\n",
      "plot(slow, \"Slow\", color.new(color.gray, 50))"
    ],
