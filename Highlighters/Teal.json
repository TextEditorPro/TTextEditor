{
  "Highlighter": {
    "Sample": [
      "-- Hello, World! in Teal\r\n",
      "\r\n",
      "local record Point\r\n",
      "  x: number\r\n",
      "  y: number\r\n",
      "  metamethod __add: function(Point, Point): Point\r\n",
      "end\r\n",
      "\r\n",
      "local enum Color\r\n",
      "  \"red\"\r\n",
      "  \"green\"\r\n",
      "end\r\n",
      "\r\n",
      "local max_points <const>: integer = 0x10\r\n",
      "\r\n",
      "local function greet(name: string, color?: Color): string\r\n",
      "  if color is Color then\r\n",
      "    return \"Hello, \" .. name .. \"!\\n\"\r\n",
      "  end\r\n",
      "\r\n",
      "  return (\"Hello, %s!\"):format(name as string)\r\n",
      "end\r\n",
      "\r\n",
      "print(greet(\"World\"))"
    ],
