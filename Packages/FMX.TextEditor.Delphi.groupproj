<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{D673F232-25D9-4250-97C7-B99FD077C6C5}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="FMX.TextEditor.Delphi.Runtime.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="FMX.TextEditor.Delphi.Designtime.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="FMX_TextEditor_Delphi_Runtime">
        <MSBuild Projects="FMX.TextEditor.Delphi.Runtime.dproj"/>
    </Target>
    <Target Name="FMX_TextEditor_Delphi_Runtime:Clean">
        <MSBuild Projects="FMX.TextEditor.Delphi.Runtime.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FMX_TextEditor_Delphi_Runtime:Make">
        <MSBuild Projects="FMX.TextEditor.Delphi.Runtime.dproj" Targets="Make"/>
    </Target>
    <Target Name="FMX_TextEditor_Delphi_Designtime">
        <MSBuild Projects="FMX.TextEditor.Delphi.Designtime.dproj"/>
    </Target>
    <Target Name="FMX_TextEditor_Delphi_Designtime:Clean">
        <MSBuild Projects="FMX.TextEditor.Delphi.Designtime.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FMX_TextEditor_Delphi_Designtime:Make">
        <MSBuild Projects="FMX.TextEditor.Delphi.Designtime.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="FMX_TextEditor_Delphi_Runtime;FMX_TextEditor_Delphi_Designtime"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="FMX_TextEditor_Delphi_Runtime:Clean;FMX_TextEditor_Delphi_Designtime:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="FMX_TextEditor_Delphi_Runtime:Make;FMX_TextEditor_Delphi_Designtime:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
